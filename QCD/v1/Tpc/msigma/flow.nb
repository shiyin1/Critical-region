Cell[BoxData[{
 RowBox[{
  RowBox[{"fitscale", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{"cl", "[", 
          RowBox[{"[", 
           RowBox[{"i", "+", "1"}], "]"}], "]"}], "+", 
         RowBox[{"cl", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], "2."], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"FindFit", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Log", "[", 
               RowBox[{"cl", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ";;", 
                  RowBox[{"i", "+", "1"}]}], "]"}], "]"}], "]"}], ",", 
              RowBox[{"Log", "[", 
               RowBox[{
                RowBox[{"Tpc", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ";;", 
                   RowBox[{"i", "+", "1"}]}], "]"}], "]"}], "-", 
                RowBox[{"Tpc", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "}"}], "]"}], ",", 
           RowBox[{"a", "+", 
            RowBox[{"b", " ", "x"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"a", ",", "b"}], "}"}], ",", "x"}], "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "2", ",", 
       RowBox[{"me", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ListPlot", "[", 
    RowBox[{"fitscale", ",", 
     RowBox[{"ScalingFunctions", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Log\>\"", ",", "Automatic"}], "}"}]}]}], "]"}], ",", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0.001", ",", 
         FractionBox["1.", 
          RowBox[{"0.397", "*", "4.784"}]]}], "}"}], ",", 
