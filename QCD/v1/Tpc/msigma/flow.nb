Cell[BoxData[{
 RowBox[{
  RowBox[{"fitscale", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"(*", 
       FractionBox[
        RowBox[{
         RowBox[{"cl", "[", 
          RowBox[{"[", 
           RowBox[{"i", "+", "1"}], "]"}], "]"}], "+", 
         RowBox[{"cl", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], "2."], "*)"}], 
      RowBox[{
       RowBox[{"mpi", "[", 
        RowBox[{"[", "i", "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"FindFit", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Log", "[", 
               RowBox[{"cl", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ";;", 
                  RowBox[{"i", "+", "1"}]}], "]"}], "]"}], "]"}], ",", 
              RowBox[{"Log", "[", 
               RowBox[{
                RowBox[{"Tpc", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ";;", 
                   RowBox[{"i", "+", "1"}]}], "]"}], "]"}], "-", 
                RowBox[{"Tpc", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "}"}], "]"}], ",", 
           RowBox[{"a", "+", 
            RowBox[{"b", " ", "x"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"a", ",", "b"}], "}"}], ",", "x"}], "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
