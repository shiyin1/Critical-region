Cell[BoxData[{
 RowBox[{
  RowBox[{"fpi", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Import", "[", 
       RowBox[{"\"\<./Tem\>\"", "<>", 
        RowBox[{"ToString", "[", "i", "]"}], 
        "<>", "\"\</BUFFER/FPI.DAT\>\""}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "100"}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Zphi", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Import", "[", 
       RowBox[{"\"\<./Tem\>\"", "<>", 
        RowBox[{"ToString", "[", "i", "]"}], 
        "<>", "\"\</BUFFER/ZPHI.DAT\>\""}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "100"}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fpi0", "=", "fpi"}], 
  RowBox[{"(*", 
   RowBox[{"/", 
    SqrtBox["Zphi"]}], "*)"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "=", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Import", "[", 
        RowBox[{"\"\<./Tem\>\"", "<>", 
         RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\</BUFFER/H.DAT\>\""}],
         "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "100"}], "}"}]}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"h", "=", 
     RowBox[{"h", "*", 
      SqrtBox["Zphi"]}]}], ";"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"h", ",", "fpi"}], "}"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.970283128277092*^9, 3.97028320745055*^9}, {
